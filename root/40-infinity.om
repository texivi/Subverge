#>> infinity
# ordinals, cardinals

[ { o } 11 color "  " write o . 7 color ] :show

# past finite
[ "count" title nl
  0 6 [ show 6 sleep ] for
  8 color "  After every natural number:" say 7 color 20 sleep
  omega ->w
  w show 10 sleep  w 1 + show 6 sleep  w 2 + show 6 sleep
  wipe
  8 color "  After all of those:" say 7 color 14 sleep
  w 2 * show 8 sleep  w 2 * 1 + show 6 sleep  w 3 * show 8 sleep
  8 color "  \w*n, then \w*\w:" say 7 color 14 sleep
  w w * show 8 sleep  w w * 1 + show 6 sleep  w w w * * show 8 sleep
  8 color "  \w^n, then \w^\w:" say 7 color 14 sleep
  w w ^ show 8 sleep  w w ^ 1 + show 6 sleep  w w w ^ ^ show 8 sleep  w w w w ^ ^ ^ show 8 sleep
  8 color "  The limit of towers of \w:" say 7 color 20 sleep
  epsilon0 show
  8 color "  \w^x = x" say
  "  The first uncountable ordinal:" say 7 color 20 sleep
  omega1 show
  omega1 card { c } 8 color "  Its size is " write 7 color c . 8 color
  "  Whether that is the size of the real numbers can't be decided in ZFC." say 7 color
  "omega" title
] :count

[ { line q } 8 color "  " write line write "   " write 11 color q do . 7 color ] :fact

# ordinal arithmetic
[ nl
  "1 + \w            " [ 1 omega + ] fact
  "\w + 1            " [ omega 1 + ] fact
  "2 * \w            " [ 2 omega * ] fact
  "\w * 2            " [ omega 2 * ] fact
  "(\w + 1) + \w      " [ omega 1 + omega + ] fact
  "(\w + 1) ^ 2      " [ omega 1 + 2 ^ ] fact
  "2 ^ \w            " [ 2 omega ^ ] fact
  "\w ^ \w            " [ omega omega ^ ] fact
  "\w ^ e0 = e0 ?    " [ omega epsilon0 ^ epsilon0 = ] fact
  "\w + 1 > \w ?      " [ omega 1 + omega > ] fact
  "1 + \w > \w ?      " [ 1 omega + omega > ] fact
  nl 8 color "  Cardinals:" say 7 color
  "\A0 + \A0         " [ aleph0 aleph0 + ] fact
  "card of \w*2      " [ omega 2 * card ] fact
  "2 ^ aleph0       " [ 2 aleph0 ^ ] fact
  "aleph0 < 2^aleph0" [ aleph0 2 aleph0 ^ < ] fact
  "aleph1 <= 2^a0   " [ aleph1 continuum <= ] fact
  8 color "  aleph1 continuum = has no answer, ZFC can't decide it" say 7 color nl
] :ord-demo

# list
[ { xs } [ [ ] ] ->acc
  xs [ { x } acc acc [ x append ] map cat ->acc ] each
  acc
] :powerset

# naturals, evens
[ "pairing" title nl
  8 color "  naturals    evens       squares     integers" say 7 color
  0 12 [ { n }
    "  " write n str 12 fmt write n 2 * str 12 fmt write n n * str 12 fmt write
    n 2 mod 0 = [ n 2 / neg ] [ n 1 + 2 / ] if str say 8 sleep
  ] for
  8 color "  Every row has a partner, so all four have size " write 11 color aleph0 . 7 color
  "omega" title
] :pairing

# cantor diagonal
[ "diagonal" title wipe nocursor
  "Cantor's diagonal argument" 2 0 14 text
  12 ->n 0 n range [ drop 0 40 range [ drop 2 rand ] map ] map ->rows
  0 n [ { r }
    r str 2 r 2 + 8 text
    0 40 [ { c } rows r at c at 48 + 5 c + r 2 + 7 put ] for
    "..." 46 r 2 + 8 text
  ] for
  30 sleep
  "Flip the diagonal:" 2 n 3 + 7 text
  0 n [ { i }
    rows i at i at 48 + 5 i + i 2 + 14 4 attr put
    rows i at i at 1 swap - 48 + 5 i + n 4 + 10 put
    10 sleep
  ] for
  "..." 5 n + n 4 + 8 text
  "This row differs from row k at position k, for every k." 2 n 6 + 7 text
  "So it is not in the list, and 2^aleph0 is bigger than aleph0." 2 n 7 + 11 text
  "Press any key." 2 n 9 + 8 text key drop wipe "omega" title
] :diagonal

# zeno
[ "supertask" title wipe nocursor
  "Draw half the line, then half of what is left, forever." 2 1 14 text
  64 ->left 0 ->x 64 ->wait 0 ->steps
  [ left 0 > ] [
    left 2 / 1 max { seg }
    0 seg [ { i } 219 8 x + i + 4 10 put ] for
    x seg + ->x  left seg - ->left  steps 1 + ->steps
    "step " steps str cat "  " cat 8 6 7 text
    wait sleep wait 2 / 1 max ->wait
  ] while
  "The screen runs out of pixels, but the series doesn't." 2 8 7 text
  "Infinitely many steps, in finite time." 2 9 11 text
  "Press any key." 2 11 8 text key drop wipe "omega" title
] :supertask
