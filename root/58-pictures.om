#>> pictures
# picture viewer

[ gfx pictures { l } l len { n } 0 { i } 1 { going }
  [ going ] [
    0 0 640 480 0 box
    l i at picture { b }
    b bmp-size { w h }
    b 640 w - 2 / 480 h - 2 / bmp-show
    b bmp-free
    l i at "  " cat i 1 + str cat "/" cat n str cat "   arrows, q leaves" cat 8 464 7 text
    key { k }
    k quit-key? [ 0 ->going ] when
    k 259 = k 32 = or k 110 = or [ i 1 + n mod ->i ] when
    k 258 = k 112 = or [ i n + 1 - n mod ->i ] when
  ] while
  gfx-off
] :gallery

[ { name rows } 0 0 640 480 0 box
  name picture { b } b 40 130 bmp-show b bmp-free
  0 rows len [ { i } rows i at { r } r 0 at 310 108 i 18 * + r 1 at text ] for
  rows 0 at 0 at 311 108 rows 0 at 1 at text
] :credit-page

[ gfx
  "texivi" [
    [ "texivi" 14 ]
    [ "creator of Subverge" 7 ]
    [ "" 7 ]
    [ "Space for the next page, q leaves." 8 ]
  ] credit-page
  key quit-key? not [
    "gretagen" [
      [ "gretagen" 14 ]
      [ "creator of HaliadeSYS" 7 ]
      [ "" 7 ]
      [ "The haelide theme and its logo come" 7 ]
      [ "from HaliadeSYS, also known as Zerene OS." 7 ]
      [ "https://github.com/gretagen/HaliadeSYS" 11 ]
      [ "" 7 ]
      [ "Space for the next page, q leaves." 8 ]
    ] credit-page
    key quit-key? not [
      "vsauce" [
        [ "Vsauce" 14 ]
        [ "the inspiration for Subverge" 7 ]
        [ "" 7 ]
        [ "His video How To Count Past Infinity" 7 ]
        [ "is why omega has ordinals and cardinals," 7 ]
        [ "and why the kernel and the shell are" 7 ]
        [ "named after them." 7 ]
        [ "youtube.com/watch?v=SrU9YDoXE88" 11 ]
        [ "" 7 ]
        [ "Any key leaves." 8 ]
      ] credit-page
      key drop
    ] when
  ] when
  gfx-off
] :credits
