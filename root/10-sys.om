#>> sys
# logos, stats

# a line is a string, or a list of strings in colours 14 and 15
[ [ "   _.--._" " .'  .-'" [ "/   /  " "/\\_/\\" ] [ "|   |  " "( -.-)" ]
    [ "\\   \\  " "(___)~" ] " '.  '-.__.-'" "   '-.____.-'" ] ] :logo-subverge

[ [
  "           MMM"
  "           MMMM"
  "           MMMMM"
  "           MMMMMM"
  "           MMMMMMa"
  "           MMMMMMMa"
  "           MMMMMMM"
  "            MMMMMM"
  "             MMMM"
  "                M"
  "               oxdo aMa"
  "           aMd     aMMMMMMMMM"
  "         aMMMMM     MMMMMMMMMMMMMMa"
  "       MMMMMMMa       MMMMMMMMMMMMMMMa"
  "     MMMMMMMMa"
  "   MMMMMMMMa"
  " MMMMMMM"
  "MMMM"
] ] :logo-haelide

[ "user" ] :user
[ "Subverge 0.9.5" ] :os
[ "subverge" ] :host
[ "ordinal 1.0.5 x86_64" ] :kernel-name

[ heap drop kernel drop + { used }
  used kb " / " cat kernel nip mb cat
] :memline

[ { line } line type "string" = [ line len ] [ 0 line [ len + ] each ] if ] :sys-width

[ { line } line type "string" =
  [ 14 color line write ]
  [ 0 line len [ { i } 14 i 2 mod + color line i at write ] for ] if
] :sys-line

[ { label val } where { x y }
  14 color label 9 fmt write 7 color val 0 78 x - 9 - 0 max slice write
] :stat

[ nl
  "logo-" logo@ cat >sym dup defined? not [ drop 'logo-subverge ] when get do { art }
  0 art [ sys-width max ] each 5 + { col }
  0 art len 9 max [ { i }
    "  " write i art len < [ art i at sys-line ] when
    where { x y } col y cursor
    i 0 = [ 15 color user "@" cat host cat write ] when
    i 1 = [ "os" os stat ] when
    i 2 = [ "kernel" kernel-name stat ] when
    i 3 = [ "uptime" uptime stat ] when
    i 4 = [ "shell" "omega 1.0.5" stat ] when
    i 5 = [ "cpu" cpu stat ] when
    i 6 = [ "memory" memline stat ] when
    i 8 = [ [ 8 15 3 13 9 14 10 12 ] [ color 7 emit " " write ] each ] when
    nl
  ] for
  7 color nl
] :sys

[ home 0 < { live }
  live
    [ "  You are running Subverge from a live ISO, so nothing you do is saved." say
      "  Type install to put it on a drive and keep your work." say ]
    [ "  You are running Subverge, installed on drive " write home str write "." say
      "  Your tabs and your edits to root are saved after every line." say ] if
  nl
  14 color "  Type learn for a guided tour of the language." say 7 color
  14 color "  Type apps to see the programs you can run." say 7 color
  "  Type help to see every command." say
  "  F1 to F4 switch tabs, and Ctrl-C stops code that is running." say
  14 color "  Type docs to read the help pages." say 7 color
  "  Type root to see the utilities, and 'name open to edit one." say
  "  Type themes to change the colours, for example 'raw theme." say
  "  Type logos to change the logo, and 'user open to change the name." say
  nl 8 color "  To remove this message, type 'startup open." say 7 color
] :welcome

[ sys welcome ] :startup
