#>> golden
# golden ratio

[ { x } x 1800 x - * { p } 4000 p * 4050000 p - / ] :sin0

[ { a } a 3600 mod { b }
  b 1800 < [ b sin0 ] [ b 1800 - sin0 neg ] if
] :sin10

[ 900 + sin10 ] :cos10

[ gfx 0 0 640 480 0 box
  [ [ 0 0 1 ] [ 1 0 1 ] [ 0 1 2 ] [ -3 0 3 ] [ -3 -5 5 ] [ 2 -5 8 ] [ -3 3 13 ] [ -24 -5 21 ] ] { sqs }
  0 8 [ { i }
    sqs i at { q }
    q 0 at { x }
    q 1 at { y }
    q 2 at { s }
    x 24 + 18 * 14 + { sx }
    16 y s + - 18 * 40 + { sy }
    s 18 * { w }
    sx sy w w 8 box
    sx 1 + sy 1 + w 2 - w 2 - 1 box
    s str sx 4 + sy 4 + 7 text
  ] for
  [ 1 1 2 3 5 8 13 21 ] { fib }
  0 1 { px py }
  180 { th }
  0 8 [ { k }
    fib k at { s }
    th 10 * cos10 1000 / { ux }
    th 10 * sin10 1000 / { uy }
    px s ux * - { cx }
    py s uy * - { cy }
    s 28 * { np }
    0 np 1 + [ { j }
      th 10 * j 900 * np / + { a }
      a cos10 { co }
      a sin10 { si }
      cx 24 + 18 * 1000 * s 18 * co * + 1000 / 14 + { dx }
      16000 cy 1000 * s si * + - 18 * 1000 / 40 + { dy }
      dx dy 14 dot
      dx 1 + dy 14 dot
      dx dy 1 + 14 dot
    ] for
    th 90 + 10 * cos10 1000 / { vx }
    th 90 + 10 * sin10 1000 / { vy }
    cx s vx * + ->px
    cy s vy * + ->py
    th 90 + 360 mod ->th
  ] for
  "spiral    space next, q leaves" 8 464 7 text
] :golden-spiral

[ gfx 0 0 640 480 0 box
  1 700 [ { m }
    m 1000000 * sqrt 9 * 1000 / { r }
    m 1375078 * 1000 / 3600 mod { a }
    320 r a cos10 * 1000 / + { x }
    240 r a sin10 * 1000 / - { y }
    x 1 - y 1 - 3 3 m 8 mod 8 + box
  ] for
  "sunflower    space next, q leaves" 8 464 7 text
] :golden-seeds

[ gfx-off wipe nocursor
  60 { d }
  10 d ^ { one }
  one 5 one one * * sqrt + 2 / { phi }
  phi str { ps }
  ps 0 1 slice "." cat ps 1 d slice cat { sp }
  "phi" 2 1 7 text
  sp 8 1 14 text
  "k" 2 3 8 text
  "F(k+1) / F(k)" 8 3 8 text
  "same" 71 3 8 text
  [ 3 5 8 12 20 30 50 80 120 ] { ks }
  0 ks len [ { i }
    ks i at { k }
    0 1 { a b }
    k [ a b + { t } b ->a t ->b ] times
    b one * a / str { rs }
    rs 0 1 slice "." cat rs 1 d slice cat { sr }
    0 { m }
    [ m 61 < sr m 1 slice sp m 1 slice = and ] [ m 1 + ->m ] while
    k str 2 5 i 2 * + 7 text
    sr 8 5 i 2 * + 8 text
    sr 0 m slice 8 5 i 2 * + 10 text
    m str 71 5 i 2 * + 7 text
  ] for
  "space next, q leaves" 2 23 8 text
] :golden-digits

[ "golden" title
  1 { going }
  0 { view }
  [ going ] [
    view 0 = [ golden-spiral ] when
    view 1 = [ golden-seeds ] when
    view 2 = [ golden-digits ] when
    key { k }
    k quit-key? [ 0 ->going ] when
    k 32 = k 259 = or [ view 1 + 3 mod ->view ] when
    k 258 = [ view 2 + 3 mod ->view ] when
  ] while
  gfx-off
  wipe
  "omega" title
] :golden
