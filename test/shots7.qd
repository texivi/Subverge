# theme gallery, logos
wait 5000
cmd 'dusk theme  ~600
cmd wipe  ~300
cmd sys  ~800
cmd [ 3 1 2 ] sort .  ~400
cmd 1 0 /  ~400
shot build/80-theme-dusk.png
