cmd wipe  ~300
cmd sys  ~800
cmd [ 3 1 2 ] sort .  ~400
cmd 1 0 /  ~400
shot build/80-theme-paper.png
cmd 'amber theme  ~600
cmd wipe  ~300
cmd sys  ~800
cmd [ 3 1 2 ] sort .  ~400
cmd 1 0 /  ~400
shot build/80-theme-amber.png
cmd 'phosphor theme  ~600
cmd wipe  ~300
cmd sys  ~800
cmd [ 3 1 2 ] sort .  ~400
cmd 1 0 /  ~400
shot build/80-theme-phosphor.png
cmd 'haelide theme  ~600
